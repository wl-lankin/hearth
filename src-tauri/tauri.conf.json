{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hearth",
  "version": "1.0.5",
  "identifier": "de.wolfganglinz.hearth",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1440",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hearth",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#120e0c"
      },
      {
        "label": "panel",
        "url": "panel.html",
        "title": "Hearth",
        "width": 300,
        "height": 420,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: http: https:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Wolfgang Linz",
    "copyright": "Copyright 2026 Wolfgang Linz",
    "homepage": "https://wolfgang-linz.de",
    "category": "DeveloperTool",
    "shortDescription": "A local PHP development environment.",
    "longDescription": "Hearth runs PHP sites on .test domains with HTTPS, databases and other services, a mail catcher, dumps and logs, from one tray app.",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM3NDAwMzNFRjZCQkY4MkEKUldRcStMdjJQZ05BeHc0K3VOZ1l6ZGpOWmdMWTRQb200UnFJZzJiWENjMUJMclNQR1FkemhaWGkK",
      "endpoints": [
        "https://github.com/wl-lankin/hearth/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
